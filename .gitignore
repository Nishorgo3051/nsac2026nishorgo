# 782 MB of downloaded Landsat imagery: re-fetchable with nodir-hishab/scripts
nodir-hishab/data/

# installed packages
node_modules/

# Python caches
__pycache__/
*.pyc

# script outputs, regenerated by a run; the Feni result is kept because build_pack.py reads it
# and re-running needs a large radar download
sar-flood/out/*
!sar-flood/out/Feni_s1_flood_2024-08-21.geojson
!sar-flood/out/Feni_s1_flood_2024-08-21.json
!sar-flood/out/Feni_s1_flood_2024-08-21.png
*.tif

# Shakti Map keeps its own git history inside its own folder
/shakti-map/

# credentials must never be committed
.env
.netrc
_netrc

# generated: a 1.4 MB inlined copy of the pack, rebuilt by pack/embed_pack.py
guidebook/app/pack-embed.js
ingito/app/pack-embed.js
brag-output-*/brag*.mp4
brag-output-*/assets/*.png
brag-output-*/composition/assets/

# Raw GeoNames country file: fetch_context.py downloads it again when it is missing.
ingito/context/geonames/

